{
  "name": "wardrobe",
  "version": "2.0.0",
  "private": true,
  "description": "A self-hosted wardrobe with ChatGPT-powered imports and complete S3 backups.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "build": "vite build",
    "preview": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "s3": "node --env-file-if-exists=.env scripts/s3.mjs",
    "smoke:images": "node --env-file-if-exists=.env scripts/smoke-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/lib-storage": "3.1145.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@openai/codex": "0.149.1",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "ajv": "8.20.0",
    "busboy": "1.6.0",
    "ipx": "^3.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "tar": "7.5.22"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.3"
  }
}
